# ==================== App Settings ====================
APP_NAME=Pollen
PORT=5000

# ==================== Model Settings ====================
MODEL_REPO=mistralai/Mixtral-8x7B-Instruct-v0.1
MODEL_DISPLAY_NAME=Mixtral 8x7B Instruct
MODEL_BADGE=8x7B
# MODEL_CARD_URL=https://huggingface.co/mistralai/Mixtral-8x7B-Instruct-v0.1
# MODEL_LICENSE_URL=https://huggingface.co/mistralai/Mixtral-8x7B-Instruct-v0.1/blob/main/LICENSE
DEFAULT_MAX_TOKENS=500

# ==================== Network Settings ====================
# Comma-separated list of Petals DHT peer multiaddresses (required)
DHT_INITIAL_PEERS=/ip4/YOUR_IP/tcp/31337/p2p/YOUR_PEER_ID

# ==================== UI Settings ====================
SHOW_PETALS_BRANDING=true
WELCOME_MESSAGE=A powerful mixture-of-experts model running on a decentralized Petals network.

# ==================== IRC Bot Settings ====================
IRC_ENABLED=true
IRC_SERVER=magickbeans.com
IRC_PORT=6667
IRC_CHANNEL=#pollen
IRC_NICKNAME=PollenBot
# IRC_API_BASE=http://127.0.0.1:5000

# ==================== Matrix Bot Settings ====================
MATRIX_ENABLED=false
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@pollenbot:example.com
MATRIX_ACCESS_TOKEN=syt_your_access_token_here
MATRIX_ROOM_ID=!roomid:example.com
# MATRIX_DISPLAY_NAME=PollenBot
# MATRIX_API_BASE=http://127.0.0.1:5000

# ==================== Image Generation Settings ====================
IMAGE_ENABLED=true
IMAGE_MODEL=stabilityai/sdxl-turbo
IMAGE_DEVICE=cpu
IMAGE_STEPS=4
IMAGE_WIDTH=512
IMAGE_HEIGHT=512

# ==================== RAG Search Settings ====================
RAG_ENABLED=false
RAG_MAX_RESULTS=3
# Comma-separated domains to restrict RAG search results (leave empty for unrestricted)
RAG_SOURCES=wikipedia.org,reuters.com,apnews.com

# ==================== Scholarly Search Settings ====================
# Papers from OpenAlex, PubMed and arXiv are merged into the same result pool as
# web results. All of these are optional; the defaults are shown.
SCHOLARLY_ENABLED=true
# Providers to query, in merge order. semanticscholar only runs when S2_API_KEY is set.
SCHOLARLY_PROVIDERS=openalex,pubmed,semanticscholar,arxiv
# Most papers allowed in one answer's sources (higher when the question asks for research)
SCHOLARLY_MAX_RESULTS=2
SCHOLARLY_MAX_RESULTS_RESEARCH=4
# Skip papers cited fewer times than this (waived when the question asks for recent work)
SCHOLARLY_MIN_CITATIONS=10
# Relevance bar on the reranker score: absolute floor, and how far below the best
# web result a paper may score on questions that do not ask for research
SCHOLARLY_MIN_RERANK=4.0
SCHOLARLY_RERANK_MARGIN=3.0
# Optional keys / contact address for higher rate limits (all work without)
OPENALEX_MAILTO=
OPENALEX_API_KEY=
S2_API_KEY=
NCBI_API_KEY=
